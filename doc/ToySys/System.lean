import ISA
import MiniIMX93

/-!
# A core of `ISA.lean` on the toy i.MX 93 of `MiniIMX93.lean`

`MiniIMX93.lean` is generated by Sockeye's Lean backend from the Sockeye model
`sockeye/examples/mini_imx93.soc` (see `generate_MiniIMX93.sh`). Its state,
`MainState`, is the state of everything in that model: the DRAM, the TRDC
(Trusted Resource Domain Controller) with its memory-mapped registers, and the
initiators, among them a USB controller.

Here, a core as defined by `ISA.lean` is added to that platform. The state of
the whole system is a core state and a platform state. The core's loads and
stores at addresses that are not in its own memory become requests from the
CPU's domain to the interconnect of the platform. This file defines what such a
load or store does, both for proofs (`imx93`, a `Platform`) and for running
with concrete values (`Effects.run`).

The scenarios configure the TRDC by running a firmware program on the core,
whose stores reach the TRDC's registers through the interconnect, and then let
a USB controller that has gone rogue try to overwrite Linux's memory.
-/

namespace ToySys

/-! ## Loads and stores of the core on the platform -/

/-- Whether a core address can be sent to the platform, whose addresses have 32
bits. -/
def IsPhysAddr (a : Word) : Prop := a.toNat < 2 ^ 32

instance (a : Word) : Decidable (IsPhysAddr a) :=
  inferInstanceAs (Decidable (a.toNat < 2 ^ 32))

/-- The request of the core for a load (`mode := .read`) or a store of `v` to
address `a`. Values have 32 bits on the platform. -/
def coreRequest (a v : Word) (mode : AccessMode) : Request :=
  { address := a.setWidth 32, value := v.setWidth 32, mode := mode,
    domain_id := CPU_DOMAIN_ID }

/-- The platform of the toy i.MX 93, for proofs: the core's loads and stores at
addresses outside its memory are served by the interconnect, as computed by the
translation of the Sockeye model in the specification monad `SpecM`. An access
that the interconnect denies, or to an address of more than 32 bits, is an
error. -/
def imx93 : Platform MainState where
  load a p post :=
    IsPhysAddr a /\
    SpecM.wp (Interconnect.request Instances.main.system.interconnect
        (coreRequest a 0 .read))
      (fun reply p' => reply.ok = true /\ post (reply.value.setWidth 64) p') p
  store a v p post :=
    IsPhysAddr a /\
    SpecM.wp (Interconnect.request Instances.main.system.interconnect
        (coreRequest a v .write))
      (fun reply p' => reply.ok = true /\ post p') p

/-! ## Running with concrete values -/

/-- Runs a request of the core on the platform in the execution monad `ExecM`,
with `seed` determining the values that `any` picks. -/
def runRequest (seed : Nat) (p : MainState) (a v : Word) (mode : AccessMode) :
    Except String (Prod Reply MainState) :=
  if IsPhysAddr a then
    match ExecM.run (Interconnect.request Instances.main.system.interconnect
        (coreRequest a v mode)) seed p with
    | (ExecResult.success reply, p') =>
      if reply.ok then .ok (reply, p') else .error s!"bus error at {a}"
    | (ExecResult.assertionFailed code, _) =>
      .error s!"assertion failed in the platform: {code}"
    | (ExecResult.assumptionFailed code, _) =>
      .error s!"assumption failed in the platform: {code}"
  else .error s!"address {a} has more than 32 bits"

/-- The effects interpreter for running with concrete values: performs the
effects `e` with the platform in state `p`. -/
def Effects.run (seed : Nat) : Effects -> MainState ->
    Except String (Prod State MainState)
  | .done s, p => .ok (s, p)
  | .error msg, _ => .error msg
  | .nonmem_load a ret, p =>
    match runRequest seed p a 0 .read with
    | .ok (reply, p') => (ret (reply.value.setWidth 64)).run seed p'
    | .error msg => .error msg
  | .nonmem_store a v ret, p =>
    match runRequest seed p a v .write with
    | .ok (_, p') => ret.run seed p'
    | .error msg => .error msg

/-- Runs the core on the platform until its program counter is `stop`, for at
most `fuel` steps. -/
def Core.run (seed fuel : Nat) (syms : Symbols) (prog : Program) (stop : Word)
    (sp : Prod State MainState) : Except String (Prod State MainState) :=
  if sp.1.pc = stop then .ok sp
  else match fuel with
    | 0 => .error "out of fuel"
    | fuel + 1 =>
      match (Core.step syms prog sp.1).run seed sp.2 with
      | .ok sp' => Core.run seed fuel syms prog stop sp'
      | .error msg => .error msg

/-- The program that holds `code` at address `base` and nothing else. -/
def Program.ofCode (base : Word) (code : List Instr) : Program :=
  fun a => if (a - base) % 4 = 0 then code[((a - base) / 4).toNat]? else none

/-! ## The firmware: configuring the TRDC -/

/-- The address of the TRDC register at byte offset `o` in the register block
of the TRDC manager of the NICMIX domain. -/
def trdcReg (o : Word) : Word := 0x49010000 + o

/-- Stores `v` to address `a`, using `X0` and `X1`. -/
def storeWord (a v : Word) : List Instr :=
  [.mov .X1 (.imm v), .mov .X0 (.imm a), .str .X1 .X0 0]

/-- The configuration that both firmwares write: `GLBAC0` (global access
control 0) allows read, write and execute, `GLBAC1` allows read and write, and
region 0 of the CPU's domain 3 is all of DRAM with the rights of `GLBAC0`. -/
def commonConfig : List Instr :=
  storeWord (trdcReg 0x18020) 0x7 ++
  storeWord (trdcReg 0x18024) 0x6 ++
  storeWord (trdcReg 0x18340) 0x80000000 ++
  storeWord (trdcReg 0x18344) 0xFFFFC001

/-- Sets `GVLDR` (global valid for the memory region checkers) in `TRDC_CR`
(the TRDC control register), which ends deny-by-default mode, and returns. -/
def enableTrdcAndReturn : List Instr :=
  storeWord (trdcReg 0x0) 0x8000 ++ [.ret .X30]

/-- A firmware that confines the USB controller (domain 11) to the 16MB that
are set aside for DMA (direct memory access) by devices, 0x90000000 to
0x90FFFFFF, with the rights of `GLBAC1`. -/
def good_firmware_code : List Instr :=
  commonConfig ++
  storeWord (trdcReg 0x18B40) 0x90000001 ++
  storeWord (trdcReg 0x18B44) 0x90FFC001 ++
  enableTrdcAndReturn

/-- A firmware that lets the USB controller read and write all of DRAM. -/
def bad_firmware_code : List Instr :=
  commonConfig ++
  storeWord (trdcReg 0x18B40) 0x80000001 ++
  storeWord (trdcReg 0x18B44) 0xFFFFC001 ++
  enableTrdcAndReturn

/-- Where the firmware is loaded, and where it returns to. -/
def firmwareBase : Word := 0x1000
def returnAddress : Word := 0x2000

/-- The core out of reset, about to run the firmware: it has no memory of its
own, so all its loads and stores go to the platform. -/
def resetCore : State :=
  { regs := fun r => if r = .X30 then returnAddress else 0, flags := {},
    mem := fun _ => none, pc := firmwareBase }

/-- Runs a firmware on the core, from reset, with the platform out of reset
(all TRDC registers and all of DRAM zero), until it returns. -/
def runFirmware (code : List Instr) : Except String (Prod State MainState) :=
  Core.run 0 100 (fun _ => 0) (Program.ofCode firmwareBase code) returnAddress
    (resetCore, {})

/-! ## Scenarios: a rogue USB controller -/

/-- Linux owns the first 256MB of DRAM, i.e. byte offsets 0 to 0x0FFFFFFF. -/
def linuxLast : BitVec 31 := 0x0FFFFFFF

/-- The USB controller writes `0xDEADBEEF` to physical address `a`. -/
def rogueUsbWrite (a : PhysAddr) (p : MainState) : MainState :=
  (ExecM.run (Interconnect.request Instances.main.system.interconnect
      { address := a, value := 0xDEADBEEF, mode := .write,
        domain_id := USB_DOMAIN_ID }) 0 p).2

/-- The word at DRAM byte offset `off`. -/
def dramWord (p : MainState) (off : BitVec 31) : BitVec 32 :=
  let b := p.system.dram.backing
  b (off + 3) ++ b (off + 2) ++ b (off + 1) ++ b off

/-- Runs a firmware, then lets the USB controller write to `0x80001000`, in
Linux's memory, and returns the word there, or the error that stopped the
firmware. -/
def linuxWordAfterAttack (code : List Instr) : Except String (BitVec 32) :=
  match runFirmware code with
  | .ok (_, p) => .ok (dramWord (rogueUsbWrite 0x80001000 p) 0x1000)
  | .error msg => .error msg

/-- info: Except.ok 0x00000000#32 -/
#guard_msgs in
#eval linuxWordAfterAttack good_firmware_code

/-- info: Except.ok 0xdeadbeef#32 -/
#guard_msgs in
#eval linuxWordAfterAttack bad_firmware_code

/-- The firmware ends where it should, with the TRDC enabled. -/
def firmwareResult (code : List Instr) : Except String (Prod Word (BitVec 32)) :=
  match runFirmware code with
  | .ok (s, p) => .ok (s.pc, p.system.trdc_mgr.raw_regs 0)
  | .error msg => .error msg

/-- info: Except.ok (0x0000000000002000#64, 0x00008000#32) -/
#guard_msgs in
#eval firmwareResult good_firmware_code

/-! ## Proving: Linux's memory is protected -/

/-! Rules for `SpecM.wp`, the weakest precondition of the code translated from
Sockeye, which let `simp` step through it. -/

@[simp] theorem SpecM.wp_bind {S A B : Type} (m : SpecM S A) (f : A -> SpecM S B)
    (post : B -> S -> Prop) (s : S) :
    SpecM.wp (m >>= f) post s =
      SpecM.wp m (fun a s' => SpecM.wp (f a) post s') s := rfl

@[simp] theorem SpecM.wp_pure {S A : Type} (a : A) (post : A -> S -> Prop)
    (s : S) : SpecM.wp (pure a : SpecM S A) post s = post a s := rfl

@[simp] theorem SpecM.wp_getState {S : Type} (post : S -> S -> Prop) (s : S) :
    SpecM.wp (SockeyeMonad.getState : SpecM S S) post s = post s s := rfl

@[simp] theorem SpecM.wp_setState {S : Type} (s' : S) (post : Unit -> S -> Prop)
    (s : S) :
    SpecM.wp (SockeyeMonad.setState s' : SpecM S Unit) post s = post () s' := rfl

@[simp] theorem SpecM.wp_any {S A : Type} [RandomVal A] (post : A -> S -> Prop)
    (s : S) :
    SpecM.wp (SockeyeMonad.any A : SpecM S A) post s = forall x, post x s := rfl

@[simp] theorem SpecM.wp_ite {S A : Type} {c : Prop} [Decidable c]
    (a b : SpecM S A) (post : A -> S -> Prop) (s : S) :
    SpecM.wp (if c then a else b) post s =
      if c then SpecM.wp a post s else SpecM.wp b post s := by
  split <;> rfl

/-- Whatever request the USB controller sends, it does not change any byte of
Linux's memory, provided that the TRDC registers that describe the regions of
the USB controller's domain 11 hold what the good firmware writes there: region
0 is the DMA region with the rights of `GLBAC1`, and regions 1 to 3 are not
valid. (Index `i` of the register block is the register at byte offset `4 * i`;
`0x62D0` is `MRC0_DOM11_RGD0_W0`.) -/
theorem usb_cannot_write_linux (p : MainState)
    (h0 : p.system.trdc_mgr.raw_regs 0x62D0#15 = 0x90000001)
    (h1 : p.system.trdc_mgr.raw_regs 0x62D1#15 = 0x90FFC001)
    (h3 : p.system.trdc_mgr.raw_regs 0x62D3#15 = 0)
    (h5 : p.system.trdc_mgr.raw_regs 0x62D5#15 = 0)
    (h7 : p.system.trdc_mgr.raw_regs 0x62D7#15 = 0) :
    SpecM.wp (Usb.step Instances.main.system.usb)
      (fun _ p' => forall a : BitVec 31, a <= linuxLast ->
        p'.system.dram.backing a = p.system.dram.backing a) p := by
  simp [Usb.step, Interconnect.request, TRDC_MRC.request, TRDC_MRC.is_access_allowed,
    TRDC_MRC.is_region_hit, TRDC_MRC.is_access_allowed_by_region, TRDC_MRC.is_allowed_by_glbac,
    TRDC_MGR.get_TRDC_CR, TRDC_MGR.offset_TRDC_CR, TRDC_MGR.read32bit_reg,
    TRDC_MGR.get_MRC0_DOMd_RGDr_Ww, TRDC_MGR.offset_MRC0_DOMd_RGDr_Ww,
    TRDC_MGR.get_MRC0_GLBACn, TRDC_MGR.offset_MRC0_GLBACn, TRDC_MGR.MRC_BASE,
    Dram.request, GenericSink.request,
    Lens.getM, Lens.loadM, Lens.storeM, Lens.modifyM, Lens.compose, Lens.id, Vec.set,
    Instances.main.system.usb, Instances.main.system.interconnect, Instances.main.system.mrc,
    Instances.main.system.trdc_mgr, Instances.main.system.dram, Instances.main.system.usb_regs,
    MainState.lens_system, SystemState.lens_trdc_mgr, SystemState.lens_dram,
    TRDC_MGRState.lens_raw_regs, DramState.lens_backing,
    USB_DOMAIN_ID, CPU_DOMAIN_ID, TRDC_MRC.ALLOWED_DEFAULT_DID, h0, h1, h3, h5, h7]
  intro x _ _ hlo hhi _ _ a ha
  -- The USB controller can only write in the DMA region, which none of the
  -- four bytes written overlaps with Linux's memory.
  simp only [linuxLast] at ha
  simp only [BitVec.ule, decide_eq_true_eq] at hlo hhi
  have hoff : 0x10000000#31 <= x.address.extractLsb' 0 31 /\
      x.address.extractLsb' 0 31 <= 0x10FFFFFF#31 := by
    have : (x.address.extractLsb' 0 31).toNat = x.address.toNat % 2 ^ 31 := by
      simp [BitVec.extractLsb'_toNat]
    bv_omega
  generalize x.address.extractLsb' 0 31 = off at hoff ⊢
  have h3 : a ≠ off + 3#31 := by bv_omega
  have h2 : a ≠ off + 2#31 := by bv_omega
  have h1 : a ≠ off + 1#31 := by bv_omega
  have h0 : a ≠ off := by bv_omega
  simp [h3, h2, h1, h0]

/-- The platform state after the good firmware has run. -/
def goodPlatform : MainState :=
  match runFirmware good_firmware_code with
  | .ok (_, p) => p
  | .error _ => {}

/-- The good firmware runs without error, and leaves the TRDC registers of the
USB controller's regions as `usb_cannot_write_linux` needs them. This is shown
by running it. -/
theorem good_firmware_configures_trdc :
    (runFirmware good_firmware_code).toOption.isSome = true /\
    goodPlatform.system.trdc_mgr.raw_regs 0x62D0#15 = 0x90000001 /\
    goodPlatform.system.trdc_mgr.raw_regs 0x62D1#15 = 0x90FFC001 /\
    goodPlatform.system.trdc_mgr.raw_regs 0x62D3#15 = 0 /\
    goodPlatform.system.trdc_mgr.raw_regs 0x62D5#15 = 0 /\
    goodPlatform.system.trdc_mgr.raw_regs 0x62D7#15 = 0 := by
  native_decide

/-- After the good firmware, a rogue USB controller cannot change Linux's
memory. -/
theorem linux_protected_after_good_firmware :
    SpecM.wp (Usb.step Instances.main.system.usb)
      (fun _ p' => forall a : BitVec 31, a <= linuxLast ->
        p'.system.dram.backing a = goodPlatform.system.dram.backing a)
      goodPlatform := by
  obtain ⟨_, h0, h1, h3, h5, h7⟩ := good_firmware_configures_trdc
  exact usb_cannot_write_linux goodPlatform h0 h1 h3 h5 h7

/-- The bad firmware leaves a different region 0 for the USB controller, so
`usb_cannot_write_linux` does not apply (and the `#eval` above shows that the
rogue write gets through). -/
theorem bad_firmware_lets_usb_into_dram :
    (match runFirmware bad_firmware_code with
      | .ok (_, p) => p.system.trdc_mgr.raw_regs 0x62D0#15
      | .error _ => 0) = 0x80000001 := by
  native_decide

end ToySys
