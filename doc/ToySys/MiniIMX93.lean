      (any_hit &&
       (!r0_hit || (<- self.is_access_allowed_by_region r r0_w0)) &&
       (!r1_hit || (<- self.is_access_allowed_by_region r r1_w0)) &&
       (!r2_hit || (<- self.is_access_allowed_by_region r r2_w0)) &&
